# ===== HireMind AI — environment template =====
# Copy to `.env` for the local CLI engine, and/or to `backend/.env.local`
# for the LangGraph LiveKit agent. Never commit the filled-in files.

# --- LLM providers ---
# Groq powers the local CLI engine. Free key: https://console.groq.com
GROQ_API_KEY=
# OpenRouter powers the backend LangGraph agent. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
# Google API key for the LiveKit STT/TTS plugins (backend agent).
GOOGLE_API_KEY=
# Optional: path to a Google Cloud service-account JSON (only for GCP voice).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Local Ollama fallback (optional, used by the CLI if Groq is absent) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- LiveKit (real-time voice/video) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Database (backend persistence: PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://algo:algo@localhost:5432/algo

# --- Logging ---
LOG_LEVEL=INFO

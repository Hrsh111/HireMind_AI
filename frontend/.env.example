# HireMind AI frontend environment variables.
# Copy this file to `.env.local` and fill in real values.
# Vars prefixed with NEXT_PUBLIC_ are exposed to the browser; the rest are server-only.

# --- LiveKit server credentials (used by /api/livekit-token to mint access tokens) ---
# Server-only. Never expose these to the client.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LiveKit client config ---
# WebSocket URL of your LiveKit server (e.g. wss://your-project.livekit.cloud or ws://localhost:7880).
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Default room name pre-filled in the UI and used as a fallback when minting tokens.
NEXT_PUBLIC_DEFAULT_ROOM=algo-room
# Optional pre-generated LiveKit token to pre-fill the token field (usually left blank;
# tokens are normally generated at runtime via /api/livekit-token).
NEXT_PUBLIC_LIVEKIT_TOKEN=

# --- Code execution (/api/execute) ---
# Timeout in ms for the remote Piston code-execution request (default: 12000).
PISTON_TIMEOUT_MS=12000
# Set to "local" to enable the on-box Python demo fallback when Piston is unavailable.
# Any other value (or unset) keeps the fallback disabled.
EXECUTE_FALLBACK=
# The following only apply when EXECUTE_FALLBACK=local (local Python demo fallback):
# Wall-clock timeout in ms for local execution (default: 4000).
LOCAL_EXEC_TIMEOUT_MS=4000
# Virtual memory limit in KB applied via `ulimit -v` (default: 262144).
LOCAL_EXEC_MEMORY_KB=262144
# Max stdout/stderr buffer in bytes for the local child process (default: 65536).
LOCAL_EXEC_MAX_BUFFER=65536
